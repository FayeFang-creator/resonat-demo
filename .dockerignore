# The build context only needs backend/, the frontend sources and serve.py.
# Without these excludes, node_modules (119M) and .venv (36M) get uploaded too,
# making the build slow and the image large.
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
frontend/dist

# Secrets and runtime state must never enter the image
.env
.env.*
!.env.sample
backend/memory/*.md
backend/profile/memory/*.md
backend/profile/memory/*.json
backend/profile/*.db
backend/profile/analysis

# Hackathon-provided dataset (to be deleted after the event, see
# CHALLENGE_AGREEMENT.md section 2) — no longer needed at runtime either
data/

# Docs and assets the running demo does not need
.git
.github
guides/
notebooks/
docs/
*.md
!README.md
