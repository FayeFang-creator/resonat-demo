# Secrets
.env
.env.*
!.env.sample

# --- Post-event compliance (CHALLENGE_AGREEMENT.md, section 2) ---
# Neither the hackathon-provided dataset nor any Cyanite model output may enter
# this repository: the agreement forbids redistributing them and requires their
# deletion after the event. Retrieval here does not depend on them.
/data/
/response_*.json
/guides/
/notebooks/

# macOS / editor / python
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/

# python venv
.venv/

# node
node_modules/

# 运行时记忆（每用户 markdown，非源码）
backend/memory/*.md

# --- profile module runtime (do not commit secrets / Cyanite outputs) ---
backend/**/.cache/
backend/profile/memory/*.md
backend/profile/memory/*.json
!backend/profile/memory/.gitkeep
backend/profile/analysis/*.png
backend/profile/*.db
