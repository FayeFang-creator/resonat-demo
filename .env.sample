# Copy this to `.env` and fill in your own values. `.env` is git-ignored.
# The demo itself needs NO keys — the sponsor's Cyanite API was retired after the
# event, and search now runs against the local catalog in this repository.
# Everything below is an optional enhancement; leave it blank for the
# deterministic fallbacks.

# Optional: LLM-written intent interpretations and recommendation explanations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Optional: enables the high-quality download proxy; required to rebuild the
# catalog (backend/build_catalog.py). This is Jamendo's PUBLIC identifier, not a
# secret — safe to set as a plain environment variable on a deploy platform.
JAMENDO_CLIENT_ID=
